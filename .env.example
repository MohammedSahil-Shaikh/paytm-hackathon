# DayZero local environment (copy to .env.local)
# No Docker. No OpenAI.

# -----------------------------
# REQUIRED for live AI + research (Beyond 9TO5 Track 1)
# Get key: https://serpapi.com/manage-api-key
# -----------------------------
SERPAPI_API_KEY=

# LLM via SerpApi Google Gemini (engine=google_gemini)
LLM_PROVIDER=serpapi_gemini

# -----------------------------
# OPTIONAL — Track 2 (Member 2 research citations)
# Docs: https://you.com/docs
# -----------------------------
YOU_COM_API_KEY=

# -----------------------------
# OPTIONAL — Supabase persistence (coordinator)
# Dashboard → Project Settings → API Keys
# Prefer new publishable/secret keys; legacy anon/service_role still work.
# -----------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy alias (optional): NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=
# Legacy alias (optional): SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
